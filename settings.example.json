{
  // SEC-GO 模型配置示例模板（复制为 settings.json 使用，含密钥勿提交 git）
  // llm / subscriptions / agents 为模型配置；web 为 Web 登录与端口；run_limits 为任务预算
  "llm": {
    "enabled": true,
    "provider": "openai-compatible",
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-v4-flash",
    "timeout_seconds": 60,
    "max_response_bytes": 2000000
  },
  "subscriptions": {
    "coding": {
      "provider": "openai-compatible",
      "baseURL": "https://api.deepseek.com/v1",
      "modelId": "deepseek-v4-flash",
      "apiKey": ""
    }
  },
  "agents": {},
  "web": {
    // 访问密码 sha256 hash（可留空 = 不设密码）。生成：python -c "import hashlib;print(hashlib.sha256(b'密码').hexdigest())"
    "admin_password_hash": "",
    // 明文密码（仅调试用，hash 非空时优先用 hash）
    "admin_password": "",
    // Cookie 签名密钥：python -c "import secrets;print(secrets.token_hex(32))"
    "secret_key": "dev-insecure-secret-change-me-xxxxxxxxxxxxxxxxx",
    "port": 8380
  },
  "run_limits": {
    "max_steps": 50,
    "max_replans": 2,
    "max_seconds": 600
  }
}